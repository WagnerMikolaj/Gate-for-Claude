# Production refuses to start without explicit configuration.
GATE_ORIGIN=https://gate.company.example
GATE_HOST=127.0.0.1
GATE_PORT=8080
GATE_TENANTS_FILE=./config/tenants.example.json
GATE_AUDIT_DB=./data/audit.db
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATE_AUDIT_KEY=
# Remains false until SSO, endpoint/network enforcement and live tests pass.
GATE_ALLOW_EXTERNAL_AI=false
ACME_OIDC_SECRET=
ACME_ANTHROPIC_KEY=
BETA_OIDC_SECRET=
BETA_ANTHROPIC_KEY=
